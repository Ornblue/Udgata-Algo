# Add your free Upstox Analytics Token from Developer Apps → Analytics.
# It is read-only and provides quotes, candles, and option chains.
UPSTOX_ANALYTICS_TOKEN=put_your_token_here

# Optional: enables AI chat replies. Without a key, a small built-in helper works.
# OpenAI API usage may require billing on your API account.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
